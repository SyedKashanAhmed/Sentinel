            "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/e5c29a23-08d6-472b-87c1-5be37290eb59')]",
            "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/e5c29a23-08d6-472b-87c1-5be37290eb59')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "kind": "Scheduled",
            "apiVersion": "2023-12-01-preview",
            "properties": {
                "displayName": "CLARA - When someone sign in",
                "description": "",
                "severity": "Medium",
                "enabled": true,
                "query": "SigninLogs\r\n| where ResultType == \"0\"\r\n| where LocationDetails contains \"GB\"\r\n| project Identity, AppDisplayName, IPAddress, UserPrincipalName, LocationDetails, UserDisplayName\r\n| where UserPrincipalName != \"testgarole@zojakashanoutlook.onmicrosoft.com\"",
                "queryFrequency": "PT5M",
                "queryPeriod": "PT5M",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
                "suppressionDuration": "PT5H",
                "suppressionEnabled": false,
                "startTimeUtc": null,
                "tactics": [
                    "InitialAccess"
                ],
                "techniques": [
                    "T1078"
                ],
                "subTechniques": [],
                "alertRuleTemplateName": null,
                "incidentConfiguration": {
